# Environment — API (backend)
# Copy to .env at the repo root. Spring Boot reads it automatically
# (spring.config.import in backend/src/main/resources/application.yml)
# and docker-compose reads it too (env_file). KEY=value only.

# Database (Neon or local Docker Postgres)
DATABASE_URL=jdbc:postgresql://localhost:5432/mithai
DATABASE_USERNAME=jb
DATABASE_PASSWORD=jb

# Security
JWT_SECRET=change-me-32-bytes-minimum-secret!!
QR_HMAC_SECRET=change-me-32-bytes-minimum-secret!!
QR_KEY_ID=k1
FRONTEND_ORIGIN=http://localhost:3000

# Auth (Google OAuth — staff allowlist)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OTP: email | sms | dev
OTP_PROVIDER=email
OTP_TTL_MINUTES=5

# Email: console | resend
EMAIL_PROVIDER=console
EMAIL_FROM=bookings@yourdomain.com
RESEND_API_KEY=
RECEIPT_CC_EMAILS=amit@example.com,shailesh@example.com
TRUSTEE_ALERT_EMAILS=admin1@example.com,admin2@example.com

# Razorpay (test keys for staging; live + trust merchant for go-live)
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional override of DB booking_enabled
# BOOKING_ENABLED_OVERRIDE=true

# NOTE: do not put PORT here — Spring Boot maps server.port from ${PORT},
# so a PORT in this file would move the API off 8080.
# Frontend-only vars live in frontend/.env.local:
#   API_PROXY_TARGET=http://localhost:8080
#   NEXT_PUBLIC_API_BASE_URL=/api
